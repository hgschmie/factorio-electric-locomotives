{
  "name": "electric-locomotives",
  "version": "2.0.8",
  "title": "Electric Locomotives",
  "description": "Adds multiple tiers of electric locomotives",
  "author": "hgschmie",
  "contact": "https://github.com/hgschmie/factorio-electric-locomotives/issues",
  "homepage": "https://github.com/hgschmie/factorio-electric-locomotives",
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1.7",
    "(?)boblogistics",
    "(?)bobvehicleequipment",
    "(?)MultipleUnitTrainControl",
    "! ElectricTrain2",
    "! ElectricTrainFix",
    "! ElectricTrainFix2"
  ],
  "package": {
    "git_publish_branch": "main",
    "readme": "README.md",
    "gallery": [
      "portal/et1.png", "portal/et2.png"
    ],
    "sync_portal_details": true,
    "ignore": [
      "graphics/src/*",
      "portal/*",
      "releases/*",
      "**/*.xcf",
      "**/.zip",
      ".git",
      ".gitignore",
      ".vscode",
      ".claude",
      "CLAUDE.md",
      ".DS_Store"
    ]
  }
}
